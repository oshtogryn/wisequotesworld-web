rom":"2026-09-01"},{"rule_key":"all_eight_social_locales_active","rule_group":"languages","rule_value":"All eight locales uk, ru, pl, en, sv, de, es and fr are active for website, Pinterest, Facebook, Instagram, Threads, TikTok and YouTube. French no longer has a website/Pinterest-only exception.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"quote_length_gate","rule_group":"video","rule_value":"Before prompts and copy, verify the quote can be read naturally within the actual current Gemini/Veo interface/model duration. Do not hard-code a universal 10 seconds, rush voiceover, or shorten verified verbatim wording under the guise of exact quotation.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"production_prompt_v45","rule_group":"video","rule_value":"Production prompts follow MASTER_RULES v4.6: premium vertical 9:16, one coherent cinematic concept, immediate meaningful frame, exact localized stable text card(s), clean large upper-middle typography, natural native narration, restrained music below voice, one concise negative line and a clean final shot. QA diagnostics stay outside the generation prompt.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"verbatim_author_visual_strategy","rule_group":"video","rule_value":"Verified verbatim quotations use a distinct premium author-specific micro-film: dignified recognizable author treatment appropriate to the person/period, quote-specific cinematic metaphor and progression, no fake historical-footage implication, no generic superhero/motivational-ad treatment, exact quote wording and explicit attribution.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"adapted_visual_strategy","rule_group":"video","rule_value":"Adapted/original Wise Quotes World thoughts keep the established cinematic human/symbolic storytelling family. Do not convert adapted quotes into philosopher busts, museum portraits or author cards, and do not add an author.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"pinterest_ai_frozen","rule_group":"pinterest","rule_value":"Automatic AI generation of Pinterest images is frozen until explicitly re-enabled. Standard workflow is manual image generation from the prepared Pinterest prompt, then Admin upload to R2, QA and approval.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"pinterest_eight_of_eight","rule_group":"pinterest","rule_value":"Pinterest is mandatory for every approved topic in all eight locales uk, ru, pl, en, sv, de, es and fr, with the approved locale image, localized SEO title/description, correct locale board and exact same-language article URL.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"social_to_local_article","rule_group":"social_copy","rule_value":"Every social post is self-contained and substantive and funnels toward the same-language Wise Quotes World destination according to platform link behavior. Never send a locale to another language when a localized destination exists.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"social_hashtag_limit","rule_group":"social_copy","rule_value":"Use no more than 5 hashtags in any social post or caption. Prefer relevant hashtags over quantity and retain #WiseQuotesWorld when appropriate.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-03"},{"rule_key":"platform_link_policy","rule_group":"social_copy","rule_value":"Facebook and Threads copy must include the exact clickable same-language article URL. Instagram and YouTube video descriptions omit raw article URLs and use a natural localized profile-link CTA. TikTok keeps the locale website address visibly in the caption as plain text even when it is not clickable; never falsely call it clickable or say link in profile when no TikTok profile website link exists. Pinterest uses the exact same-language article as the destination link.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"metricool_primary_now","rule_group":"scheduling","rule_value":"Metricool remains the primary scheduler during the current stabilization phase. No item is considered scheduled until Planner readback confirms the planned publication.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"all_eight_social_locales","rule_group":"scheduling","rule_value":"Scheduling readiness for Wise Quotes World social publishing requires all eight active locales, including French, plus Pinterest 8/8, media QA and final approval.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"},{"rule_key":"website_full_archive_categories","rule_group":"website","rule_value":"The public website must expose the full published quote archive from D1 for every locale. Category and verified-author pages are live D1 queries. All eight locales uk, ru, pl, en, sv, de, es and fr are active.","status":"approved","mandatory":1,"version":1,"effective_from":"2026-09-01"}],"operational":{"items":[{"id":"WQ006","status":"published"},{"id":"WQ011","status":"published"}],"wq006_pages":{"total":8,"published":8,"first_published_at":"2026-08-29","last_published_at":"2026-08-29"},"wq011_pages":{"total":8,"published":8,"first_published_at":"2026-08-29T20:44:26.686Z","last_published_at":"2026-08-29T20:44:26.686Z"}}}}